{
  "name": "magical-birthday-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/db/database.types.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:secrets",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "scan:history": "node scripts/scan-git-history-secrets.mjs"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@supabase/supabase-js": "^2.53.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "autoprefixer": "10.4.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "next": "^15.5.27",
    "openai": "^5.11.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.0.1",
    "server-only": "^0.0.1",
    "sonner": "1.7.1",
    "swr": "^2.5.1",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.13",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.5.4",
    "vaul": "1.1.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "22.7.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "supabase": "^2.119.0",
    "vitest": "^3.2.7"
  }
}
