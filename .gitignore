# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
ideavo-server.log
ideavo-build.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
prisma/*.db

# test files
test-*.js
test-*.html

# local env files (never commit secrets)
.env
.env.*
!.env.example
!.env.e2e

# playwright / test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# supabase local
supabase/.branches
supabase/.temp
/.next-e2e/

# Builder / tool artifacts (never commit)
.ideavo/
.ideavo-attachments/
ideavo-server.info
logs/
.next-*/

# Local tool settings
.claude/settings.local.json

# Credentials / local secrets (never commit)
*.key
*.p12
*.pfx
service-account*.json
*credentials*.json
.sentryclirc
.secrets/
secrets/
*.secret
*.log

# Local QA / scratch artifacts
.qa*
/tmp/
