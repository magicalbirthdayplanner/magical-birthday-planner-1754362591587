# Magical Birthday Planner — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Every variable below is read by the current application (verified by inventory).

# =============================================================================
# PUBLIC (shipped to the browser — must never contain secrets)
# =============================================================================
# Supabase project (the anon/publishable key is public by design; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin used in email/invitation links, the Dodo return URL and metadata.
# Production: https://magicalbirthdayplanner.app (also the built-in default when VERCEL_ENV=production).
# Preview: leave empty (uses the deployment URL). Local: http://localhost:3100
NEXT_PUBLIC_BASE_URL=
# Google Maps JavaScript API — a SEPARATE browser key, restricted to "Maps JavaScript API"
# and HTTP referrers of your domains. Empty → simplified schematic map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (required for Advanced Markers; create in Google Cloud → Map Management)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional: set to true to disable the service worker
NEXT_PUBLIC_DISABLE_SW=false
# Sentry DSN (Project Settings → Client Keys). Public by design: it only lets a browser SEND events.
# Empty → Sentry is disabled everywhere (local dev, tests); the app works the same.
NEXT_PUBLIC_SENTRY_DSN=

# Temporary pre-launch waitlist mode (docs/PRELAUNCH.md): auto (default: Oct 6–12 2026 America/New_York) | on | off
# PRELAUNCH_MODE=auto
# Optional owner bypass during pre-launch: open /?preview=<token> (secret, 24+ chars). Unset = no bypass.
# PRELAUNCH_PREVIEW_TOKEN=
# Vercel Cron bearer secret for /api/cron/* (launch reminder). Unset = cron endpoints refuse.
# CRON_SECRET=

# =============================================================================
# SERVER ONLY (never prefix with NEXT_PUBLIC_; `npm run check:secrets` enforces this)
# =============================================================================
# --- Supabase ---------------------------------------------------------------
# Service role / secret key: shared venue cache, analytics, RSVP RPC, billing webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places API (New) -------------------------------------------------
# Server key restricted to "Places API (New)" (+ "Geocoding API" for the rare ZIP
# fallback when a ZIP is missing from the offline dataset).
GOOGLE_PLACES_API_KEY=
# Cost guards (defaults shown) — see docs/GOOGLE_PLACES_COST_CONTROL.md
GOOGLE_USER_HOURLY_CALLS=60
GOOGLE_INSTANCE_HOURLY_CALLS=2000
DISCOVERY_MAX_QUERIES=8
DISCOVERY_CONCURRENCY=4
DISCOVERY_DEADLINE_MS=7000
DISCOVERY_SEARCH_TTL_HOURS=24
DISCOVERY_DETAILS_TTL_DAYS=7
# DISCOVERY_RANKING_WEIGHTS={"distance":0.25}

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=
# Sender. Empty → Resend's shared test sender (delivers only to the account owner).
# Set to an address on a domain VERIFIED in your Resend account before launch.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Abuse caps (rolling 24 h, enforced from email_logs across all instances)
EMAIL_DAILY_INVITES_PER_USER=300
EMAIL_DAILY_RSVP_EMAILS_PER_PARTY=200

# --- Dodo Payments ----------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
# test_mode | live_mode. Live charging ALSO requires DODO_LIVE_PAYMENTS_ENABLED=true.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_LIVE_PAYMENTS_ENABLED=false
# Dodo product ids for each plan (server decides product + price; clients never do)
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PLUS=
DODO_PRODUCT_PRO=
# Optional: expected USD prices in cents (defaults 999 / 1999 / 2999 from lib/entitlements.ts) and discount policy
# DODO_PRICE_STARTER_CENTS=999
# DODO_PRICE_PLUS_CENTS=1999
# DODO_PRICE_PRO_CENTS=2999
# DODO_ALLOW_DISCOUNTS=false

# --- Azure OpenAI (optional: AI theme ideas on the Theme screen) -------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# --- Sentry (observability) ------------------------------------------------
# Optional server-side DSN override (defaults to NEXT_PUBLIC_SENTRY_DSN).
SENTRY_DSN=
# BUILD-TIME ONLY: uploads source maps during `next build`, then the maps are deleted from the output.
# Use an org auth token with the project:releases / org:read scopes. Never NEXT_PUBLIC_.
# Empty → no upload (stack traces stay minified); the build still succeeds.
SENTRY_AUTH_TOKEN=
# Defaults: magical-birthday-planner / javascript-nextjs
# SENTRY_ORG=
# SENTRY_PROJECT=

# =============================================================================
# TEST-ONLY endpoint overrides (CI/E2E point these at tests/mock-google). Never set
# in Preview/Production.
# =============================================================================
# GOOGLE_PLACES_API_BASE_URL=
# GOOGLE_GEOCODING_API_BASE_URL=
# RESEND_BASE_URL=
# DODO_API_BASE_URL=

# ---- AI planning assistant (server only; never NEXT_PUBLIC_) -------------------------------------------
# Master switch: must be exactly "true". Rollback = set to false.
AI_ENABLED=false
# Comma list of features to turn on, e.g. party_planner,theme_ideas,checklist
AI_ENABLED_FEATURES=
# Party Experience UI (Activities tab, Party Magic hub). Build-time, not secret. Off until launch.
NEXT_PUBLIC_EXPERIENCE_ENABLED=false
# opencode | openai | anthropic | mock   (mock = deterministic fixtures; never use in production)
AI_PROVIDER=opencode
# Server-only provider key (OpenCode Go). Never commit a value.
AI_API_KEY=
# Optional. Defaults for opencode: https://opencode.ai/zen/go/v1 and deepseek-v4-pro
AI_BASE_URL=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=3000
AI_TIMEOUT_MS=45000
# Long answers (Plan My Party, theme ideas, food, party experience); max 55000 (route limit 60 s)
AI_LONG_TIMEOUT_MS=55000
AI_MAX_RETRIES=1
# Circuit breaker: total generations per UTC day across all users
AI_GLOBAL_DAILY_LIMIT=2000
# Per-user generations in any rolling 24 h, all parties and features, failures included (default 30)
AI_USER_DAILY_LIMIT=30
# DeepSeek V4 'thinking' (reasoning). Keep off: with it on, answers were empty/timed out in testing.
AI_THINKING=off
