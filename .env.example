# =============================================================================
# Magical Birthday Planner — environment variables
# Copy to .env.local (never commit it). This file contains NO real values.
# Local dev/E2E against `npx supabase start`: see .env.e2e (public demo keys only).
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — shipped to every browser (NEXT_PUBLIC_*). Identifiers only, never secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon/publishable key is public by design; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BASE_URL=https://<your-deployment-domain>
# Google Maps JavaScript API key for the map ONLY (public by necessity). Use a SEPARATE key,
# API-restricted to "Maps JavaScript API" and HTTP-referrer-restricted to your domains.
# Empty → simplified schematic map (local dev/CI).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Stripe publishable key (legacy, unused by the mobile app). Publishable keys are public.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional switches
NEXT_PUBLIC_DISABLE_DOMAIN_REDIRECT=false
NEXT_PUBLIC_DISABLE_SW=false

# -----------------------------------------------------------------------------
# SERVER — never prefix with NEXT_PUBLIC_, never import from client components.
# `npm run check:secrets` fails the build check if any of these reach the browser.
# -----------------------------------------------------------------------------
# Supabase service role (bypasses RLS). Used only for shared catalogue/cache,
# analytics ingestion, RSVP RPC and server-managed entitlements.
SUPABASE_SERVICE_ROLE_KEY=
# Direct database access — maintenance scripts in database/ only, not the app runtime.
DATABASE_URL=
DIRECT_URL=

# Google Places API (New) server key — venue search, details, photos. Restrict to
# "Places API (New)" (+ "Geocoding API" only if you want the rare ZIP fallback). Never NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
# Cost guards (defaults shown) — see docs/GOOGLE_PLACES_COST_CONTROL.md
GOOGLE_USER_HOURLY_CALLS=60
GOOGLE_INSTANCE_HOURLY_CALLS=2000
DISCOVERY_MAX_QUERIES=8
DISCOVERY_CONCURRENCY=4
# Overall time budget per discovery run (ms); later categories are skipped once spent
DISCOVERY_DEADLINE_MS=7000
DISCOVERY_SEARCH_TTL_HOURS=24
DISCOVERY_DETAILS_TTL_DAYS=7
# DISCOVERY_RANKING_WEIGHTS={"distance":0.25}
# Test-only endpoint overrides (CI/E2E point these at tests/mock-google)
# GOOGLE_PLACES_API_BASE_URL=
# GOOGLE_GEOCODING_API_BASE_URL=

# Azure OpenAI (optional; AI theme ideas)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# Resend — invitations, RSVP confirmations, host notifications (server only)
RESEND_API_KEY=
# Default (empty) = Resend's shared sender "Magical Birthday Planner <onboarding@resend.dev>".
# Only set an address on a domain VERIFIED in this Resend account.
EMAIL_FROM=
# Optional; omitted when empty
EMAIL_REPLY_TO=
# Abuse caps (rolling 24 h, enforced from email_logs across all instances)
EMAIL_DAILY_INVITES_PER_USER=300
EMAIL_DAILY_RSVP_EMAILS_PER_PARTY=200

# Dodo Payments — server-created checkout + verified webhook (docs/BILLING_SECURITY.md)
DODO_PAYMENTS_API_KEY=
# Webhook signing secret from the Dodo dashboard (starts with whsec_)
DODO_PAYMENTS_WEBHOOK_SECRET=
# test_mode (default) | live_mode. Live ALSO requires DODO_LIVE_PAYMENTS_ENABLED=true.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_LIVE_PAYMENTS_ENABLED=false
# Product ids for each plan (pdt_…), from the matching Dodo mode
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PLUS=
DODO_PRODUCT_PRO=
# Optional: expected USD prices in cents (default 999 / 1999 / 2999) and discount policy
# DODO_PRICE_STARTER_CENTS=999
# DODO_PRICE_PLUS_CENTS=1999
# DODO_PRICE_PRO_CENTS=2999
# Test-only override of the Dodo API host (E2E mock); never set in Preview/Production
# DODO_API_BASE_URL=
# DODO_ALLOW_DISCOUNTS=false
# Legacy names still read by lib/env-config.ts:
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Legacy/unused integrations (safe to leave empty)
STRIPE_SECRET_KEY=
N8N_WEBHOOK_URL=

# Local development only. Ignored when NODE_ENV=production.
ENABLE_DEBUG_ROUTES=false

# Optional: redirect other production hosts to this host (no default)
NEXT_PUBLIC_CANONICAL_HOST=
