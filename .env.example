# =============================================================================
# Magical Birthday Planner — environment variables
# Copy to .env.local (never commit it). This file contains NO real values.
# Local dev/E2E against `npx supabase start`: see .env.e2e (public demo keys only).
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — shipped to every browser (NEXT_PUBLIC_*). Identifiers only, never secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon/publishable key is public by design; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BASE_URL=https://www.magicalbirthdayplanner.com
NEXT_PUBLIC_SITE_URL=https://www.magicalbirthdayplanner.com
# Google Maps JavaScript API key for the map ONLY. Use a SEPARATE key restricted to
# "Maps JavaScript API" + HTTP referrers of your domains. Required in production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Stripe publishable key (legacy, unused by the mobile app). Publishable keys are public.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional switches
NEXT_PUBLIC_DISABLE_DOMAIN_REDIRECT=false
NEXT_PUBLIC_DISABLE_SW=false

# -----------------------------------------------------------------------------
# SERVER — never prefix with NEXT_PUBLIC_, never import from client components.
# `npm run check:secrets` fails the build check if any of these reach the browser.
# -----------------------------------------------------------------------------
# Supabase service role (bypasses RLS). Used only for shared catalogue/cache,
# analytics ingestion, RSVP RPC and server-managed entitlements.
SUPABASE_SERVICE_ROLE_KEY=
# Direct database access — maintenance scripts in database/ only, not the app runtime.
DATABASE_URL=
DIRECT_URL=

# Google Places API (New) + Geocoding API (server key, restrict to those two APIs).
GOOGLE_PLACES_API_KEY=
# Cost guards (defaults shown) — see docs/GOOGLE_PLACES_COST_CONTROL.md
GOOGLE_USER_HOURLY_CALLS=60
GOOGLE_INSTANCE_HOURLY_CALLS=2000
DISCOVERY_MAX_QUERIES=8
DISCOVERY_CONCURRENCY=4
DISCOVERY_SEARCH_TTL_HOURS=24
DISCOVERY_DETAILS_TTL_DAYS=7
# DISCOVERY_RANKING_WEIGHTS={"distance":0.25}
# Test-only endpoint overrides (CI/E2E point these at tests/mock-google)
# GOOGLE_PLACES_API_BASE_URL=
# GOOGLE_GEOCODING_API_BASE_URL=

# Azure OpenAI (optional; AI theme ideas)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# Resend (optional; legacy email features)
RESEND_API_KEY=

# Dodo Payments (billing is NOT complete — see docs/BILLING_SECURITY.md)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
# Legacy names still read by lib/env-config.ts:
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Legacy/unused integrations (safe to leave empty)
STRIPE_SECRET_KEY=
GEOAPIFY_API_KEY=
POSITIONSTACK_API_KEY=
N8N_WEBHOOK_URL=

# Local development only. Ignored when NODE_ENV=production.
ENABLE_DEBUG_ROUTES=false
