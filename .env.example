# Copy to .env.local and fill in. NEVER commit real values.
# Local development against `npx supabase start` uses the values printed by `npx supabase status`.

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only, never NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Google (server only) ---
# Places API (New) + Geocoding API. Restrict by API and by server IP where possible.
GOOGLE_PLACES_API_KEY=
# Optional: override the Google endpoints (used by CI/E2E to point at the mock server)
# GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com
# GOOGLE_GEOCODING_API_BASE_URL=https://maps.googleapis.com

# --- Google Maps JavaScript API (browser key) ---
# A SEPARATE key restricted to Maps JavaScript API + HTTP referrers of your domains.
# When unset, the map view falls back to a schematic preview (dev/test only).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Discovery tuning (optional) ---
# DISCOVERY_SEARCH_TTL_HOURS=24
# DISCOVERY_DETAILS_TTL_DAYS=7
# DISCOVERY_MAX_QUERIES=8
# DISCOVERY_RANKING_WEIGHTS={"distance":0.25,"rating":0.2}

# --- AI (server only) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# --- Email (server only) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3100

# Debug/fix API routes are 404 unless this is "true" AND NODE_ENV != production
ENABLE_DEBUG_ROUTES=false
