{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:e2e)",
      "Bash(npm run dev)",
      "Bash(npm run db:start)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin main:*)",
      "Bash(git checkout master:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset --db-url:*)",
      "Bash(vercel --prod:*)"
    ]
  }
}
