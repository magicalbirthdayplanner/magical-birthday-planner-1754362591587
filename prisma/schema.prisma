generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  name                   String?
  displayName            String?
  currentPlan            SubscriptionPlan  @default(FREE)
  emailVerified          Boolean           @default(false)
  emailVerifiedAt        DateTime?
  passwordResetRequested Boolean           @default(false)
  passwordResetAt        DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  theme                  String?           @default("light")
  emailNotifications     Boolean           @default(true)
  partyReminders         Boolean           @default(true)
  marketingEmails        Boolean           @default(false)
  customThemes           CustomTheme[]
  emailLogs              EmailLog[]
  eventPurchases         EventPurchase[]
  invoices               Invoice[]
  parties                Party[]
  paymentMethods         PaymentMethod[]
  subscription           Subscription?
  themePreferences       ThemePreference[]

  @@map("users")
}

model Party {
  id                 String               @id @default(cuid())
  childName          String
  childAge           Int
  childGender        String?
  partyDate          DateTime
  partyTime          String?
  partyLocation      String?
  theme              String
  interests          String[]
  favoriteColors     String[]
  guestCount         Int?
  maxGuests          Int?
  budget             Float?
  checklistData      Json?
  packageType        EventPackage         @default(LITE_PARTY)
  status             PartyStatus          @default(PLANNING)
  rsvpDeadline       DateTime?
  hostName           String?
  hostEmail          String?
  hostPhone          String?
  customInstructions String?
  shareToken         String?              @unique
  isShared           Boolean              @default(false)
  sharedAt           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  userId             String
  eventPurchaseId    String?
  adultCount         Int?
  kidCount           Int?
  guests             Guest[]
  templates          InvitationTemplate[]
  invitations        Invitation[]
  eventPurchase      EventPurchase?       @relation(fields: [eventPurchaseId], references: [id])
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities         PartyActivity[]

  @@map("parties")
}

model Guest {
  id               String       @id @default(cuid())
  name             String
  email            String?
  phone            String?
  type             GuestType    @default(ADULT)
  age              Int?
  notes            String?
  tags             String[]     @default([])
  category         String?
  dietaryReqs      String?
  emergencyContact String?
  importedFrom     String?
  isVip            Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  partyId          String
  party            Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invitations      Invitation[]

  @@map("guests")
}

model Invitation {
  id             String           @id @default(cuid())
  status         InvitationStatus @default(PENDING)
  sentAt         DateTime?
  respondedAt    DateTime?
  message        String?
  notes          String?
  templateId     String?
  customMessage  String?
  rsvpToken      String?          @unique
  emailSent      Boolean          @default(false)
  smsSent        Boolean          @default(false)
  reminderCount  Int              @default(0)
  lastReminderAt DateTime?
  resendId       String?
  error          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  partyId        String
  guestId        String
  guest          Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  party          Party            @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, guestId])
  @@map("invitations")
}

model InvitationTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  content   String
  theme     String?
  isDefault Boolean  @default(false)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("invitation_templates")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planType             SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model EventPurchase {
  id              String        @id @default(cuid())
  userId          String
  packageType     EventPackage
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  eventsIncluded  Int           @default(1)
  eventsUsed      Int           @default(0)
  validUntil      DateTime?
  paymentIntentId String?       @unique
  transactionId   String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parties         Party[]

  @@map("event_purchases")
}

model PaymentMethod {
  id                    String            @id @default(cuid())
  userId                String
  type                  PaymentMethodType @default(CARD)
  last4                 String?
  brand                 String?
  expiryMonth           Int?
  expiryYear            Int?
  isDefault             Boolean           @default(false)
  stripePaymentMethodId String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Invoice {
  id              String        @id @default(cuid())
  userId          String
  amount          Float
  currency        String        @default("USD")
  status          InvoiceStatus @default(PENDING)
  invoiceNumber   String        @unique
  dueDate         DateTime
  paidAt          DateTime?
  stripeInvoiceId String?       @unique
  downloadUrl     String?
  packageType     EventPackage?
  eventPurchaseId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model EmailLog {
  id          String      @id @default(cuid())
  userId      String
  partyId     String?
  guestId     String?
  type        EmailType
  status      EmailStatus @default(PENDING)
  to          String
  subject     String
  resendId    String?
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_logs")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EarlyAccess {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing_page")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("early_access")
}

model PartyActivity {
  id                 String         @id @default(cuid())
  name               String
  description        String?
  supplies           String[]       @default([])
  estimatedTime      Int?
  timeUnit           String         @default("minutes")
  peopleRequired     Int?
  groupInstructions  String?
  hostScript         String?
  tips               String[]       @default([])
  sortOrder          Int            @default(0)
  isCustom           Boolean        @default(false)
  source             ActivitySource @default(AI_GENERATED)
  themeEmoji         String?
  themeContext       String?
  stepByStepScript   String?
  soundCues          String[]       @default([])
  energyLevel        EnergyLevel    @default(MEDIUM)
  isHostModeReady    Boolean        @default(false)
  fullHostScript     String?
  rulesAndVariations Json?
  materialsList      Json?
  optionalExtras     Json?
  isFullyExpanded    Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  partyId            String
  party              Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_activities")
}

model BirthdayActivity {
  id                     String           @id @default(cuid())
  name                   String
  description            String
  fullDescription        String?
  suppliesNeeded         String[]         @default([])
  setupTime              Int              @default(5)
  helpersRequired        Int              @default(1)
  stepByStepInstructions String?
  hostScript             String?
  ageGroup               AgeGroup[]
  venueType              VenueType[]
  duration               ActivityDuration
  durationMinutes        Int
  themeCompatibility     String[]         @default([])
  effortLevel            EffortLevel
  participantRange       String
  minParticipants        Int              @default(1)
  maxParticipants        Int?
  category               String
  tags                   String[]         @default([])
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@map("birthday_activities")
}

model ThemePreference {
  id         String    @id @default(cuid())
  userId     String
  themeId    String
  themeType  ThemeType @default(CLASSIC)
  isFavorite Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@map("theme_preferences")
}

model CustomTheme {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String
  emoji            String
  colorPalette     String[] @default([])
  decorations      String[] @default([])
  activities       String[] @default([])
  printableIdeas   String[] @default([])
  whyRecommended   String?
  matchScore       Int?     @default(0)
  ageAppropriate   Boolean  @default(true)
  generatedBy      String?  @default("AI")
  basedOnInterests String[] @default([])
  basedOnColors    String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custom_themes")
}

enum EmailType {
  VERIFICATION
  PASSWORD_RESET
  INVITATION
  RSVP_REMINDER
  RSVP_CONFIRMATION
  WELCOME
  NOTIFICATION
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
}

enum EventPackage {
  LITE_PARTY
  MAGICAL_PARTY
  ULTIMATE_PARTY
  PARTY_BUNDLE
  PLANNER_PRO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum PartyStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  PAYPAL
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum GuestType {
  ADULT
  CHILD
  FAMILY
  COUPLE
}

enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  ACCEPTED
  DECLINED
  MAYBE
  BOUNCED
  FAILED
}

enum ActivitySource {
  AI_GENERATED
  USER_CREATED
  THEME_DEFAULT
}

enum EnergyLevel {
  CALM
  ACTIVE
  HIGH_ENERGY
  MEDIUM
}

enum AgeGroup {
  AGE_0_2
  AGE_3_5
  AGE_6_8
  AGE_9_12
}

enum VenueType {
  INDOOR
  OUTDOOR
  MIXED
  HOME
  PARK
  PARTY_HALL
  POOL
  SCHOOL
}

enum ActivityDuration {
  DURATION_15
  DURATION_30
  DURATION_45
  DURATION_60
  DURATION_90_PLUS
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
}

enum ThemeType {
  CLASSIC
  CUSTOM
  AI_GENERATED
}
