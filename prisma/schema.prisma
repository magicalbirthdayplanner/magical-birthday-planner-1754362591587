generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  displayName    String?
  currentPlan    SubscriptionPlan @default(FREE)
  emailVerified  Boolean       @default(false)
  emailVerifiedAt DateTime?
  passwordResetRequested Boolean @default(false)
  passwordResetAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  theme          String?       @default("light")
  emailNotifications Boolean   @default(true)
  partyReminders Boolean       @default(true)
  marketingEmails Boolean      @default(false)
  parties        Party[]
  subscription   Subscription?
  paymentMethods PaymentMethod[]
  invoices       Invoice[]
  eventPurchases EventPurchase[]
  emailLogs      EmailLog[]
  themePreferences ThemePreference[]
  customThemes   CustomTheme[]

  @@map("users")
}

model Party {
  id               String       @id @default(cuid())
  childName        String
  childAge         Int
  childGender      String?
  partyDate        DateTime
  partyTime        String?      // Party time as string
  partyLocation    String?      // Full party address/location
  theme            String
  interests        String[]
  favoriteColors   String[]
  guestCount       Int?
  adultCount       Int?         // Number of adults attending
  kidCount         Int?         // Number of kids attending
  maxGuests        Int?         // Maximum guest limit based on plan
  budget           Float?
  checklistData    Json?
  packageType      EventPackage @default(LITE_PARTY)
  status           PartyStatus  @default(PLANNING)
  rsvpDeadline     DateTime?    // RSVP deadline date
  hostName         String?      // Host name for invitations
  hostEmail        String?      // Host email for replies
  hostPhone        String?      // Host contact number
  customInstructions String?    // Special instructions for guests
  shareToken       String?      @unique // Token for sharing party publicly
  isShared         Boolean      @default(false) // Whether party is shared
  sharedAt         DateTime?    // When party was shared
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userId           String
  eventPurchaseId  String?
  guests           Guest[]
  invitations      Invitation[]
  templates        InvitationTemplate[]
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventPurchase    EventPurchase? @relation(fields: [eventPurchaseId], references: [id])
  activities       PartyActivity[]

  @@map("parties")
}

model Guest {
  id            String       @id @default(cuid())
  name          String
  email         String?
  phone         String?
  type          GuestType    @default(ADULT)
  age           Int?
  notes         String?
  tags          String[]     @default([])
  category      String?      // Custom category for grouping
  dietaryReqs   String?      // Dietary requirements/restrictions
  emergencyContact String?   // Emergency contact for children
  importedFrom  String?      // CSV, manual, etc.
  isVip         Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  partyId       String
  party         Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invitations   Invitation[]

  @@map("guests")
}

model Invitation {
  id            String           @id @default(cuid())
  status        InvitationStatus @default(PENDING)
  sentAt        DateTime?
  respondedAt   DateTime?
  message       String?
  notes         String?
  templateId    String?
  customMessage String?
  rsvpToken     String?          @unique // For unique RSVP links
  emailSent     Boolean          @default(false)
  smsSent       Boolean          @default(false)
  reminderCount Int              @default(0)
  lastReminderAt DateTime?
  resendId      String?          // Resend email ID for tracking
  error         String?          // Last error message if any
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  partyId       String
  guestId       String
  guest         Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  party         Party            @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, guestId])
  @@map("invitations")
}

model InvitationTemplate {
  id          String    @id @default(cuid())
  name        String
  subject     String
  content     String
  theme       String?
  isDefault   Boolean   @default(false)
  isCustom    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  partyId     String?
  party       Party?    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("invitation_templates")
}

model Subscription {
  id                String              @id @default(cuid())
  userId            String              @unique
  planType          SubscriptionPlan    @default(FREE)
  status            SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd Boolean             @default(false)
  stripeSubscriptionId String?          @unique
  stripeCustomerId  String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model EventPurchase {
  id              String        @id @default(cuid())
  userId          String
  packageType     EventPackage
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  eventsIncluded  Int           @default(1)
  eventsUsed      Int           @default(0)
  validUntil      DateTime?     // For bundle purchases
  paymentIntentId String?       @unique
  transactionId   String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parties         Party[]

  @@map("event_purchases")
}

model PaymentMethod {
  id               String             @id @default(cuid())
  userId           String
  type             PaymentMethodType  @default(CARD)
  last4            String?
  brand            String?
  expiryMonth      Int?
  expiryYear       Int?
  isDefault        Boolean            @default(false)
  stripePaymentMethodId String?       @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Invoice {
  id                String        @id @default(cuid())
  userId            String
  amount            Float
  currency          String        @default("USD")
  status            InvoiceStatus @default(PENDING)
  invoiceNumber     String        @unique
  dueDate           DateTime
  paidAt            DateTime?
  stripeInvoiceId   String?       @unique
  downloadUrl       String?
  packageType       EventPackage?
  eventPurchaseId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}


model EmailLog {
  id          String      @id @default(cuid())
  userId      String
  partyId     String?
  guestId     String?
  type        EmailType
  status      EmailStatus @default(PENDING)
  to          String
  subject     String
  resendId    String?     // Resend email ID for tracking
  error       String?     // Error message if failed
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_logs")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum EmailType {
  VERIFICATION
  PASSWORD_RESET
  INVITATION
  RSVP_REMINDER
  RSVP_CONFIRMATION
  WELCOME
  NOTIFICATION
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

enum SubscriptionPlan {
  FREE          // Starter plan (FREE tier - basic features)
  STARTER       // Plus plan ($14.99 - enhanced features)
  PROFESSIONAL  // Pro plan ($29.99 - all features)
}

enum EventPackage {
  LITE_PARTY
  MAGICAL_PARTY
  ULTIMATE_PARTY
  PARTY_BUNDLE
  PLANNER_PRO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum PartyStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  PAYPAL
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum GuestType {
  ADULT
  CHILD
  FAMILY
  COUPLE
}



enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  ACCEPTED
  DECLINED
  MAYBE
  BOUNCED
  FAILED
}

model EarlyAccess {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing_page")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("early_access")
}

model PartyActivity {
  id              String   @id @default(cuid())
  name            String
  description     String?
  supplies        String[] @default([])
  estimatedTime   Int?     // Time in minutes
  timeUnit        String   @default("minutes") // "minutes", "hours"
  peopleRequired  Int?     // Number of people needed
  groupInstructions String? // How to split kids by age/number
  hostScript      String?  // Dialogue for parents to use
  tips            String[] @default([]) // Safety notes, fun twists, age adaptations
  sortOrder       Int      @default(0)
  isCustom        Boolean  @default(false) // True if manually added by user
  source          ActivitySource @default(AI_GENERATED)
  
  // Host Mode enhancements
  themeEmoji      String?  // Theme emoji for the activity
  themeContext    String?  // Theme setting description
  stepByStepScript String? // Detailed teleprompter script with stage directions
  soundCues       String[] @default([]) // Sound effects and music cues
  energyLevel     EnergyLevel @default(MEDIUM) // Energy level for activity switching
  isHostModeReady Boolean  @default(false) // Whether expanded for Host Mode
  
  // AI-Generated Comprehensive Content Sections
  fullHostScript  String?  // Complete host read-aloud script with energetic tone
  rulesAndVariations Json? // Rules, age variations, group size adjustments, space adjustments
  materialsList   Json?    // Detailed materials for specific guest count with prep reminders
  optionalExtras  Json?    // Prep time, play time, mess factor, adult involvement for parents
  isFullyExpanded Boolean  @default(false) // Whether all AI content sections are generated
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_activities")
}



enum ActivitySource {
  AI_GENERATED
  USER_CREATED
  THEME_DEFAULT
}

enum EnergyLevel {
  CALM
  ACTIVE
  HIGH_ENERGY
  MEDIUM
}



model BirthdayActivity {
  id                  String              @id @default(cuid())
  name                String
  description         String
  fullDescription     String?             // Detailed description for modal
  suppliesNeeded      String[]            @default([])
  setupTime           Int                 @default(5)  // Setup time in minutes
  helpersRequired     Int                 @default(1)  // Number of helpers suggested
  stepByStepInstructions String?          // Detailed step-by-step instructions
  hostScript          String?             // Optional anchor/host script for engagement
  ageGroup            AgeGroup[]          // Multiple age groups supported
  venueType           VenueType[]         // Multiple venue types
  duration            ActivityDuration    // Duration category
  durationMinutes     Int                 // Exact duration in minutes
  themeCompatibility  String[]            @default([]) // Compatible themes
  effortLevel         EffortLevel         // Low, Medium, High
  participantRange    String              // e.g., "5-10", "10+", "any"
  minParticipants     Int                 @default(1)
  maxParticipants     Int?                // null for unlimited
  category            String              // Activity category
  tags                String[]            @default([]) // Additional tags for filtering
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("birthday_activities")
}

enum AgeGroup {
  AGE_0_2     // 0-2 years
  AGE_3_5     // 3-5 years 
  AGE_6_8     // 6-8 years
  AGE_9_12    // 9-12 years
}

enum VenueType {
  INDOOR
  OUTDOOR
  MIXED
  HOME
  PARK
  PARTY_HALL
  POOL
  SCHOOL
}

enum ActivityDuration {
  DURATION_15    // 15 minutes
  DURATION_30    // 30 minutes
  DURATION_45    // 45 minutes
  DURATION_60    // 60 minutes
  DURATION_90_PLUS // 90+ minutes
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
}

model ThemePreference {
  id        String   @id @default(cuid())
  userId    String
  themeId   String   // Can be classic theme ID or custom theme ID
  themeType ThemeType @default(CLASSIC)
  isFavorite Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@map("theme_preferences")
}

model CustomTheme {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String
  emoji           String
  colorPalette    String[] @default([])
  decorations     String[] @default([])
  activities      String[] @default([])
  printableIdeas  String[] @default([])
  whyRecommended  String?
  matchScore      Int?     @default(0)
  ageAppropriate  Boolean  @default(true)
  generatedBy     String?  @default("AI") // "AI" or "USER"
  basedOnInterests String[] @default([])
  basedOnColors   String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custom_themes")
}


enum ThemeType {
  CLASSIC
  CUSTOM
  AI_GENERATED
}



