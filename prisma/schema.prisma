generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  currentPlan    SubscriptionPlan @default(FREE)
  emailVerified  Boolean       @default(false)
  emailVerifiedAt DateTime?
  onboardingSent Boolean       @default(false)
  passwordResetRequested Boolean @default(false)
  passwordResetAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  theme          String?       @default("light")
  parties        Party[]
  subscription   Subscription?
  paymentMethods PaymentMethod[]
  invoices       Invoice[]
  eventPurchases EventPurchase[]
  emailLogs      EmailLog[]

  @@map("users")
}

model Party {
  id               String       @id @default(cuid())
  childName        String
  childAge         Int
  childGender      String?
  partyDate        DateTime
  partyTime        String?      // Party time as string
  partyLocation    String?      // Full party address/location
  theme            String
  interests        String[]
  favoriteColors   String[]
  guestCount       Int?
  maxGuests        Int?         // Maximum guest limit based on plan
  budget           Float?
  location         String?      // Legacy location field
  checklistData    Json?
  packageType      EventPackage @default(LITE_PARTY)
  status           PartyStatus  @default(PLANNING)
  accessExpiresAt  DateTime?
  rsvpDeadline     DateTime?    // RSVP deadline date
  hostName         String?      // Host name for invitations
  hostEmail        String?      // Host email for replies
  hostPhone        String?      // Host contact number
  customInstructions String?    // Special instructions for guests
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userId           String
  eventPurchaseId  String?
  guests           Guest[]
  invitations      Invitation[]
  templates        InvitationTemplate[]
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventPurchase    EventPurchase? @relation(fields: [eventPurchaseId], references: [id])

  @@map("parties")
}

model Guest {
  id            String       @id @default(cuid())
  name          String
  email         String?
  phone         String?
  type          GuestType    @default(ADULT)
  age           Int?
  notes         String?
  tags          String[]     @default([])
  category      String?      // Custom category for grouping
  dietaryReqs   String?      // Dietary requirements/restrictions
  emergencyContact String?   // Emergency contact for children
  importedFrom  String?      // CSV, manual, etc.
  isVip         Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  partyId       String
  party         Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invitations   Invitation[]

  @@map("guests")
}

model Invitation {
  id            String           @id @default(cuid())
  status        InvitationStatus @default(PENDING)
  sentAt        DateTime?
  deliveredAt   DateTime?        // Email delivery confirmation
  openedAt      DateTime?        // Email open tracking
  respondedAt   DateTime?
  message       String?
  notes         String?
  templateId    String?
  customMessage String?
  rsvpToken     String?          @unique // For unique RSVP links
  emailSent     Boolean          @default(false)
  smsSent       Boolean          @default(false)
  reminderCount Int              @default(0)
  lastReminderAt DateTime?
  resendId      String?          // Resend email ID for tracking
  error         String?          // Last error message if any
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  partyId       String
  guestId       String
  guest         Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  party         Party            @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, guestId])
  @@map("invitations")
}

model InvitationTemplate {
  id          String    @id @default(cuid())
  name        String
  subject     String
  content     String
  theme       String?
  isDefault   Boolean   @default(false)
  isCustom    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  partyId     String?
  party       Party?    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("invitation_templates")
}

model Subscription {
  id                String              @id @default(cuid())
  userId            String              @unique
  planType          SubscriptionPlan    @default(FREE)
  status            SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd Boolean             @default(false)
  stripeSubscriptionId String?          @unique
  stripeCustomerId  String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model EventPurchase {
  id              String        @id @default(cuid())
  userId          String
  packageType     EventPackage
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  eventsIncluded  Int           @default(1)
  eventsUsed      Int           @default(0)
  validUntil      DateTime?     // For bundle purchases
  paymentIntentId String?       @unique
  transactionId   String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parties         Party[]

  @@map("event_purchases")
}

model PaymentMethod {
  id               String             @id @default(cuid())
  userId           String
  type             PaymentMethodType  @default(CARD)
  last4            String?
  brand            String?
  expiryMonth      Int?
  expiryYear       Int?
  isDefault        Boolean            @default(false)
  stripePaymentMethodId String?       @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Invoice {
  id                String        @id @default(cuid())
  userId            String
  amount            Float
  currency          String        @default("USD")
  status            InvoiceStatus @default(PENDING)
  invoiceNumber     String        @unique
  dueDate           DateTime
  paidAt            DateTime?
  stripeInvoiceId   String?       @unique
  downloadUrl       String?
  packageType       EventPackage?
  eventPurchaseId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model UsageLimit {
  id          String   @id @default(cuid())
  userId      String   @unique
  partiesUsed Int      @default(0)
  guestsUsed  Int      @default(0)
  aiUsed      Int      @default(0)
  resetAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("usage_limits")
}

model EmailLog {
  id          String      @id @default(cuid())
  userId      String
  partyId     String?
  guestId     String?
  type        EmailType
  status      EmailStatus @default(PENDING)
  to          String
  subject     String
  resendId    String?     // Resend email ID for tracking
  error       String?     // Error message if failed
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_logs")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum EmailType {
  VERIFICATION
  PASSWORD_RESET
  INVITATION
  RSVP_REMINDER
  RSVP_CONFIRMATION
  WELCOME
  NOTIFICATION
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

enum SubscriptionPlan {
  FREE          // Starter plan (FREE tier - basic features)
  STARTER       // Plus plan ($14.99 - enhanced features)
  PROFESSIONAL  // Pro plan ($29.99 - all features)
}

enum EventPackage {
  LITE_PARTY
  MAGICAL_PARTY
  ULTIMATE_PARTY
  PARTY_BUNDLE
  PLANNER_PRO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum PartyStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  PAYPAL
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum GuestType {
  ADULT
  CHILD
  FAMILY
  COUPLE
}



enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  ACCEPTED
  DECLINED
  MAYBE
  BOUNCED
  FAILED
}

model EarlyAccess {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing_page")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("early_access")
}


