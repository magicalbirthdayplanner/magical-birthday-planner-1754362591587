generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  theme     String?  @default("light")
  parties   Party[]

  @@map("users")
}

model Party {
  id             String       @id @default(cuid())
  childName      String
  childAge       Int
  childGender    String?
  partyDate      DateTime
  theme          String
  interests      String[]
  favoriteColors String[]
  guestCount     Int?
  budget         Float?
  location       String?
  checklistData  Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String
  guests         Guest[]
  invitations    Invitation[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parties")
}

model Guest {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  type        GuestType    @default(ADULT)
  age         Int?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  partyId     String
  party       Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invitations Invitation[]

  @@map("guests")
}

model Invitation {
  id          String           @id @default(cuid())
  status      InvitationStatus @default(PENDING)
  sentAt      DateTime?
  respondedAt DateTime?
  message     String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  partyId     String
  guestId     String
  guest       Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  party       Party            @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, guestId])
  @@map("invitations")
}

enum GuestType {
  ADULT
  CHILD
}

enum InvitationStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  MAYBE
}
